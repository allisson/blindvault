{
  "name": "@blindvault/extension",
  "version": "0.0.0",
  "private": true,
  "description": "BlindVault browser extension: manifests, service worker, and the package around apps/web's build.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @blindvault/web build:extension && node build/package.ts",
    "test": "vitest run",
    "test:coverage": "vitest run",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "vitest": "5.0.5"
  }
}
