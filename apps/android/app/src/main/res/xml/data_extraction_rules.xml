<?xml version="1.0" encoding="utf-8"?>
<!-- android.md §3 (D290): the vault database and Local Config reach neither a cloud backup nor
     another phone; the vault leaves the device only by pairing, sync or .bvault. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
