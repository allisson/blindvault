{
  "name": "@blindvault/android",
  "version": "0.0.0",
  "private": true,
  "description": "BlindVault Android app: the Kotlin shell and the APK around apps/web's Android build.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @blindvault/web build:android && node build/assets.ts && ./gradlew --no-daemon assembleRelease",
    "test": "vitest run",
    "test:coverage": "vitest run",
    "test:kotlin": "node build/assets.ts && ./gradlew --no-daemon test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "vitest": "5.0.5"
  }
}
